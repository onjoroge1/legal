# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_URL=https://www.legallawdocs.com

# Generate independent high-entropy values. Never commit real values.
NEXTAUTH_SECRET=
LEGAL_DISCLAIMER_SIGNING_SECRET=

# Database
DATABASE_URL=

# AI providers
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=LegalLawDocs <noreply@legallawdocs.com>

# Scheduled legal-fact ingestion
CRON_SECRET=
CRON_INGEST_BATCH_SIZE=10
OPENSTATES_API_KEY=

# Emergency feature flags. Keep false until the corresponding launch gate passes.
ENABLE_AI_GENERATION=false
ENABLE_PAYMENTS=false
ENABLE_ELECTRONIC_SIGNING=false
ENABLE_DOCUMENT_MUTATIONS=false

# Dedicated private read-only MCP; not a Stripe/OpenAI/account credential.
ENABLE_OPERATIONS_MCP=false
OPERATIONS_MCP_ORIGIN=
OPERATIONS_MCP_TOKEN=
# Defaults to sandbox. Set live only after release gates pass.
STRIPE_MODE=test

# Purchase delivery: enable only after staging mail/claim validation.
ENABLE_PURCHASE_DELIVERY=false
# Independent base64-encoded 32-byte key for encrypted, stable retry payloads.
EMAIL_DELIVERY_ENCRYPTION_KEY=
RESEND_WEBHOOK_SECRET=

# Private Vercel Blob store for avatars (OIDC on Vercel or static token outside Vercel)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Enable only after written retention/processor policy approval and staging rehearsal
ENABLE_PRIVACY_ERASURE=false
PRIVACY_POLICY_VERSION=
PAYMENT_RECORD_RETENTION_DAYS=

# Approved HTTPS operations receiver; accepts JSON and deduplicates Idempotency-Key
OPERATIONS_ALERT_URL=
OPERATIONS_ALERT_TOKEN=

# Only enable on verified production after content/publication and Search Console checks.
ENABLE_SEARCH_INDEXING=false
