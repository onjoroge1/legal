generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(cuid())
  name                    String
  email                   String                 @unique
  password                String
  emailVerified           DateTime?
  verificationToken       String?                @unique
  verificationTokenExpiry DateTime?
  resetToken              String?                @unique
  resetTokenExpiry        DateTime?
  image                   String?
  isAdmin                 Boolean                @default(false)
  subscriptionTier        String                 @default("free")
  subscriptionStatus      String                 @default("inactive")
  subscriptionStartDate   DateTime?
  subscriptionEndDate     DateTime?
  stripeCustomerId        String?                @unique
  stripeSubscriptionId    String?                @unique
  firstName               String?
  lastName                String?
  company                 String?
  businessName            String?
  businessType            String?
  businessId              String?
  businessAddress         String?
  businessCity            String?
  businessState           String?
  businessZip             String?
  defaultDocumentFormat   String                 @default("PDF")
  autoSaveEnabled         Boolean                @default(true)
  defaultLanguage         String                 @default("English (US)")
  timezone                String                 @default("UTC")
  emailNotifications      String?
  inAppNotifications      String?
  twoFactorEnabled        Boolean                @default(false)
  twoFactorSecret         String?
  lastPasswordChange      DateTime?
  jwtVersion              Int                    @default(0)
  activeSessions          String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  accounts                Account[]
  sessions                Session[]
  userDocuments           UserDocument[]
  blogPosts               BlogPost[]
  notifications           Notification[]
  teamMemberships         TeamMember[]
  ownedTeams              Team[]           @relation("OwnedTeams")
  sentInvitations         TeamInvitation[] @relation("SentInvitations")
  verifiedFactsReviewed   VerifiedFact[]   @relation("VerifiedFactReviewer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DocumentParty {
  id             String        @id @default(cuid())
  name           String
  type           String
  address        String?
  email          String?
  userDocumentId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userDocument   UserDocument? @relation(fields: [userDocumentId], references: [id])
}

model Questionnaire {
  id          String           @id @default(cuid())
  name        String
  description String?
  templateId  String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  metadata    Json?
  questions   Question[]
  template    DocumentTemplate @relation(fields: [templateId], references: [id])
}

model Question {
  id              String               @id @default(cuid())
  label           String
  type            String
  required        Boolean              @default(false)
  section         String
  helpText        String?
  placeholder     String?
  questionnaireId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  questionnaire   Questionnaire        @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  dependencies    QuestionDependency[]
  options         QuestionOption[]
}

model QuestionOption {
  id         String   @id @default(cuid())
  value      String
  label      String?
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionDependency {
  id                  String   @id @default(cuid())
  questionId          String
  dependsOnQuestionId String
  conditionType       String
  conditionValue      String
  createdAt           DateTime @default(now())
  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id             String          @id @default(cuid())
  code           String?         @unique
  name           String
  type           String
  description    String?
  content        String?
  state          String?
  categoryId     String
  version        String          @default("1.0.0")
  metadata       Json?
  variables      Json?
  // SEO Fields
  slug           String?         @unique
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  featuredImage  String?
  publicUrl      String?
  purchaseUrl    String?
  // Blog Post Relation
  blogPostId     String?         @unique
  blogPost       BlogPost?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  category       Category        @relation(fields: [categoryId], references: [id])
  questionnaires Questionnaire[]
  fields         TemplateField[]
}

model TemplateField {
  id           String            @id @default(cuid())
  fieldId      String
  label        String
  type         String
  required     Boolean           @default(false)
  section      String
  helpText     String?
  placeholder  String?
  templateId   String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  dependencies FieldDependency[]
  options      FieldOption[]
  template     DocumentTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, fieldId])
}

model FieldOption {
  id        String        @id @default(cuid())
  value     String
  label     String?
  fieldId   String
  createdAt DateTime      @default(now())
  field     TemplateField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model FieldDependency {
  id               String        @id @default(cuid())
  fieldId          String
  dependsOnFieldId String
  conditionType    String
  conditionValue   String
  createdAt        DateTime      @default(now())
  field            TemplateField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model Category {
  id          String             @id @default(cuid())
  name        String
  slug        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  templates   DocumentTemplate[]
  blogPosts   BlogPost[]
}

model UserDocument {
  id           String          @id @default(cuid())
  title        String
  type         String
  category     String?
  jurisdiction String?
  description  String?
  content      String
  state        String?
  status       String          @default("draft")
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  userId       String
  parties      DocumentParty[]
  user         User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model BlogPost {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  excerpt       String?
  content       String           // Markdown or rich text
  featuredImage String?
  authorId      String
  templateId    String?          @unique
  categoryId    String?
  published     Boolean          @default(false)
  publishedAt   DateTime?
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  views         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  author        User             @relation(fields: [authorId], references: [id])
  template      DocumentTemplate? @relation(fields: [templateId], references: [id])
  category      Category?        @relation(fields: [categoryId], references: [id])
  
  @@index([slug])
  @@index([published])
  @@index([templateId])
  @@index([categoryId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String    // "document" | "billing" | "team" | "system"
  title      String
  message    String
  link       String?
  metadata   Json?
  read       Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Team {
  id          String          @id @default(cuid())
  name        String?
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("OwnedTeams", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invitations TeamInvitation[]

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   // "admin" | "editor" | "viewer"
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvitation {
  id          String   @id @default(cuid())
  teamId      String
  email       String
  role        String   // "admin" | "editor" | "viewer"
  token       String   @unique
  invitedBy   String
  status      String   @default("pending") // "pending" | "accepted" | "cancelled" | "expired"
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter     User     @relation("SentInvitations", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([teamId])
  @@index([email])
  @@index([token])
  @@index([status])
}

model LawyerListing {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  email           String   @unique
  phone           String?
  tagline         String?  // short 1-liner shown on cards
  bio             String   // full bio shown on profile page
  firmName        String?
  photoUrl        String?
  websiteUrl      String?
  city            String?
  stateAbbr       String?  // primary licensed state e.g. "CA"
  practiceAreas   String[] // e.g. ["business-contracts","employment-law"]
  licensedStates  String[] // all states where licensed e.g. ["CA","NY","TX"]
  yearsExperience Int?
  featured        Boolean  @default(false)  // paid featured placement
  verified        Boolean  @default(false)  // admin verified license
  active          Boolean  @default(true)   // visible on directory
  tier            String   @default("basic") // "basic" | "featured" | "premium"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@index([stateAbbr])
  @@index([featured])
  @@index([tier])
}


/// Externally-sourced legal facts (statutes, requirements, restrictions) that have
/// been pulled from an authoritative source (OpenStates, Cornell LII, etc.) and
/// gated by human admin review before being injected into the AI prompt context.
///
/// The full pipeline lives in lib/sources/* and the admin review UI is at /admin/facts.
/// Approved facts are queried from lib/verified-facts.ts at document-generation time
/// and appended to the prompt's stateContext (see buildStateContext in
/// app/api/documents/[category]/[slug]/generate/route.ts).
model VerifiedFact {
  id                String   @id @default(cuid())
  jurisdiction      String   // slug form: "california" | "us" | "uk"
  jurisdictionType  String   // "state" | "country" | "city"
  documentSlug      String   // catalog slug: "residential-lease-agreement"
  factType          String   // "requirement" | "restriction" | "notice" | "citation"
  content           String   // verbatim sentence as it will be injected into the prompt
  citation          String?  // "Cal. Civil Code § 1954.603", if applicable
  source            String   // "openstates" | "cornell-lii" | "manual"
  sourceUrl         String   // canonical URL on the source site for verification
  status            String   @default("pending") // "pending" | "approved" | "rejected" | "superseded"
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  /// sha256(jurisdiction + documentSlug + content) — used by the unique index so that
  /// re-ingesting the same fact does not create a duplicate pending row.
  contentHash       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reviewer          User?    @relation("VerifiedFactReviewer", fields: [reviewedById], references: [id])

  @@unique([jurisdiction, documentSlug, contentHash])
  @@index([jurisdiction, documentSlug, status])
  @@index([status])
}

/// Cron-driven ingest schedule for the verified-facts pipeline.
///
/// Each row represents one (jurisdiction × documentSlug × source) combo the
/// cron should periodically re-ingest. The cursor `lastIngestedAt` lets us
/// pick the N oldest-processed entries on each run, so a small daily quota
/// (e.g. 10 calls/day on OpenStates free tier) rotates through the full
/// registry naturally over multiple days.
///
/// Seeded from lib/sources/registry.ts via either the admin UI button or
/// the cron auto-seed-on-empty path. See app/api/cron/ingest-facts/route.ts.
model IngestSchedule {
  id               String   @id @default(cuid())
  jurisdiction     String   // "california"
  jurisdictionType String   // "state" | "country" | "city"
  documentSlug     String   // catalog slug
  source           String   // "openstates" | "cornell-lii" | "manual"
  /// JSON config for the source — e.g. { "subjects": ["Housing","Landlord and Tenant"] }
  sourceConfig     Json
  /// Cursor used by the cron job: rows are picked oldest-first.
  /// NULL = never ingested → highest priority.
  lastIngestedAt   DateTime?
  /// Last run summary for ops debugging:
  /// { "fetched": N, "newlyPending": M, "alreadyKnown": K, "error"?: string }
  lastResult       Json?
  /// Toggle without deleting if a (state, doc) combo proves consistently empty.
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([jurisdiction, documentSlug, source])
  @@index([enabled, lastIngestedAt])
}
